# Normalize line endings across platforms
* text=auto eol=lf

# Windows scripts — keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.nupkg binary
*.pfx binary
*.p12 binary
