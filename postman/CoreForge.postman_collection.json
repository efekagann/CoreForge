{
  "info": {
    "name": "CoreForge API",
    "description": "CoreForge SaaS Starter Kit — Complete API collection\n\n## Setup\n1. Import this collection\n2. Set `baseUrl` variable (default: https://localhost:7001)\n3. Run **Auth / Login** → `accessToken` is auto-saved\n4. Set `tenantId` to the GUID of your target tenant\n\n## Variables\n- `baseUrl` — API root (e.g. https://localhost:7001)\n- `accessToken` — JWT, auto-saved after login\n- `tenantId` — X-Tenant-Id header for tenant-scoped calls",
    "_postman_id": "coreforge-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7001", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "tenantId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Test@1234!\",\n  \"firstName\": \"New\",\n  \"lastName\": \"User\"\n}"
            },
            "description": "Register a new user account."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@coreforge.com\",\n  \"password\": \"Admin@1234!\"\n}"
            },
            "description": "Login and receive JWT access + refresh tokens. Tokens are saved to collection variables automatically."
          }
        },
        {
          "name": "Login as Tenant Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.com\",\n  \"password\": \"Test@1234!\"\n}"
            },
            "description": "Login as Acme Corp tenant admin (seeded)."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Exchange refresh token for a new access + refresh token pair."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Invalidate the refresh token in Redis."
          }
        }
      ]
    },
    {
      "name": "Tenants (SuperAdmin)",
      "item": [
        {
          "name": "Get All Tenants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/tenants",
            "description": "List all tenants. SuperAdmin only."
          }
        },
        {
          "name": "Get Tenant by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/tenants/{{tenantId}}",
            "description": "Get a single tenant by GUID."
          }
        },
        {
          "name": "Create Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('tenantId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/tenants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Company\",\n  \"slug\": \"testco\",\n  \"plan\": \"Starter\",\n  \"contactEmail\": \"hello@testco.example\"\n}"
            },
            "description": "Create a new tenant. The new tenant ID is saved to {{tenantId}}."
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/tenants/{{tenantId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Company Updated\",\n  \"plan\": \"Professional\",\n  \"contactEmail\": \"new@testco.example\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Delete Tenant",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/tenants/{{tenantId}}"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/payments/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"Starter\",\n  \"successUrl\": \"https://yourapp.com/success\",\n  \"cancelUrl\": \"https://yourapp.com/cancel\"\n}"
            },
            "description": "Start a checkout session. With Mock provider: returns Success=true and creates subscription immediately. With Stripe: returns a redirect URL."
          }
        },
        {
          "name": "Stripe Webhook (simulate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "t=timestamp,v1=signature" }
            ],
            "url": "{{baseUrl}}/api/payments/webhook",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_xxx\",\n      \"client_reference_id\": \"{{tenantId}}\",\n      \"amount_total\": 2900,\n      \"currency\": \"usd\",\n      \"subscription\": \"sub_xxx\",\n      \"metadata\": { \"plan\": \"Starter\" }\n    }\n  }\n}"
            },
            "description": "Stripe sends this to your webhook endpoint after a successful checkout. AllowAnonymous."
          }
        },
        {
          "name": "Get Payment History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/history?page=1&pageSize=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Current Subscription",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
            ],
            "url": "{{baseUrl}}/api/payments/subscription"
          }
        }
      ]
    },
    {
      "name": "Audit Log (SuperAdmin)",
      "item": [
        {
          "name": "Get Audit Log",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auditlog?page=1&pageSize=50",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" },
                { "key": "tenantId", "value": "{{tenantId}}", "disabled": true },
                { "key": "entityName", "value": "Tenant", "disabled": true }
              ]
            },
            "description": "Filter audit entries by tenantId and/or entityName. SuperAdmin only."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Returns 200 Healthy or 503 Unhealthy."
          }
        }
      ]
    }
  ]
}
